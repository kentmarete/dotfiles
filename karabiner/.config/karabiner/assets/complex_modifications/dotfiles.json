{
  "title": "Dotfiles: developer keyboard",
  "rules": [
    {
      "description": "Caps Lock → Escape when tapped, Control when held",
      "manipulators": [
        {
          "type": "basic",
          "from": { "key_code": "caps_lock", "modifiers": { "optional": ["any"] } },
          "to": [{ "key_code": "left_control", "lazy": true }],
          "to_if_alone": [{ "key_code": "escape" }]
        }
      ]
    },
    {
      "description": "Right Command held → Hyper (⌃⌥⇧⌘) for Raycast/Rectangle shortcuts",
      "manipulators": [
        {
          "type": "basic",
          "from": { "key_code": "right_command", "modifiers": { "optional": ["any"] } },
          "to": [{ "key_code": "left_shift", "modifiers": ["left_command", "left_control", "left_option"] }]
        }
      ]
    }
  ]
}
