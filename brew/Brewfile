# Homebrew manifest. Install:  brew bundle --file=brew/Brewfile
# Check what's missing:        brew bundle check --verbose --file=brew/Brewfile
#
# RULE: only list formulae Homebrew ships PREBUILT ("bottled") for this macOS.
# On macOS 14 (Sonoma) many formulae have no bottles any more and compile
# from source (starship → rust → llvm = hours). Those tools come from mise
# instead (mise/.config/mise/config.toml), which downloads release binaries.
# Check a formula before adding it:
#   brew info --json=v2 <name> | jq '.formulae[0].bottle.stable.files | keys'
# (empty list = no bottle for this macOS = put it in mise instead)
#
# Already provided elsewhere:
#   git (2.39, Apple CLT) · curl (system) · Rust (rustup in ~/.cargo) · mise (~/.local/bin)

tap "hashicorp/tap"

